[Unit]
Description=鴨 Dakku demo, with made-up ducks (http://localhost:8642)
Documentation=https://github.com/HangAlex/dakku
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=DAKKU_FOLDER
ExecStart=/usr/bin/python3 -m dakku --demo
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
