[Unit]
Description=鴨 Dakku, the study pond (http://localhost:8640)
Documentation=https://github.com/HangAlex/dakku
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=DAKKU_FOLDER
ExecStart=/usr/bin/python3 -m dakku
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3
NoNewPrivileges=yes
UMask=0077

[Install]
WantedBy=default.target
