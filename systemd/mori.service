[Unit]
Description=鴨 Dakku, the study forest (http://localhost:8640)
Documentation=https://github.com/HangAlex/dakku
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/mori
ExecStart=/usr/bin/python3 -m mori
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3
NoNewPrivileges=yes

[Install]
WantedBy=default.target
